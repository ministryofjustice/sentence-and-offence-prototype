    "@x-govuk/govuk-prototype-filters": "^2.0.0",
    "accessible-autocomplete": "^3.0.1",
    "chalk": "^5.4.1",
    "govuk-frontend": "5.10.1",
    "govuk-prototype-kit": "13.16.2",
    "hmpps-court-cases-release-dates-design": "^4.4.0",
    "inquirer": "^12.6.1",
    "jquery": "3.7.1",
    "notifications-node-client": "8.2.1",
    "pxjs": "^0.0.0",
    "rxjs": "^7.8.2",
